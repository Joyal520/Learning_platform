{
  "rewrites": [
    { "source": "/home", "destination": "/app.html" },
    { "source": "/digital-classroom-static/:path*", "destination": "/Digital_classroom/Digital Classroom/:path*" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
